{
  "name": "project-todolist",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "author": {
    "url": "https://www.mauriziotolomeo.it",
    "name": "Maurizio Tolomeo",
    "email": "maurizio.tolomeo@outlook.it"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "biome check src && tsc -b && vitest --run --coverage",
    "biome:check": "biome check src",
    "biome:fix": "biome check --write --unsafe src",
    "dev": "vite --port=3000 --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest --run",
    "coverage": "vitest --run --coverage"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "jotai": "^2.20.0",
    "moment": "^2.30.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.14",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.11",
    "vite-plugin-checker": "^0.13.0",
    "vitest": "^4.1.5"
  }
}
